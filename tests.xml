    # Verify trimming and deduplication
    assert "Warszawa" in rows
    assert rows["Warszawa"]["COUNTRY"] == "Poland"

    # Verify null coalescing for zip code
    assert "Gdansk" in rows
    assert rows["Gdansk"]["ZIP_CODE"] == ""


