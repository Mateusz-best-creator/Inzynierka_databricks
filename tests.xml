    )
    dim_event_type = spark.createDataFrame(
        [("View", 1), ("Cart", 2)], ["EVENT_TYPE_NAME", "EVENT_TYPE_KEY"]
    )

    # Setup SCD2 product history to verify correct time-based join
    dim_product = (
        spark.createDataFrame(
